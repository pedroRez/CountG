# Example environment configuration

# Roboflow API key (used for dataset downloads)
ROBOFLOW_API_KEY=

# PostgreSQL database URL
DATABASE_URL=

# HostGator SFTP credentials
HG_HOST=
HG_USER=
HG_PASS=
HG_PORT=22
HG_DOMAIN=

# Development flags
USE_SFTP=false
CREATE_ANNOTATED_VIDEO=true

# Number of threads for computation
OMP_NUM_THREADS=12
